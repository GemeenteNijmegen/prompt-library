# gallery_mcp sidecar — PRODUCTION example (ADR 0005).
# Copy to a real env file / secret store and fill the <placeholders>.
# The sidecar holds NO secrets: it forwards the caller's bearer token to the
# gallery and validates nothing itself. Every value below is a public URL.

# Where the gallery REST API lives (the sidecar forwards tool calls here).
# Must be reachable from the sidecar's network; internal URL is fine.
GALLERY_API_URL=https://api.gallery.example.org

# Bind address / port for the sidecar process.
MCP_HOST=0.0.0.0
MCP_PORT=8001

# Public, externally-reachable URL of THIS sidecar. It is advertised verbatim as
# the `resource` identifier in /.well-known/oauth-protected-resource and inside
# the WWW-Authenticate header. If it is wrong or unreachable by the MCP client,
# OAuth discovery breaks. Include the scheme; no trailing slash.
MCP_RESOURCE_URL=https://mcp.gallery.example.org

# Keycloak realm URL advertised as the authorization server. This MUST equal the
# token `iss` claim byte-for-byte AND match the gallery API's JWT_ISSUER — all
# three identical. It must be reachable from the END USER's browser (the public
# Keycloak URL, never an internal keycloak:8080 address). No trailing slash.
KEYCLOAK_REALM_URL=https://sso.gallery.example.org/realms/gallery

# Upstream request timeout (seconds) for calls to the gallery API.
GALLERY_REQUEST_TIMEOUT=30.0
