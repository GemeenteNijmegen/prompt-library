{
  "realm": "gallery",
  "enabled": true,
  "displayName": "Prompt Gallery",
  "sslRequired": "NONE",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,

  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 2592000,
  "ssoSessionIdleTimeout": 604800,
  "offlineSessionMaxLifespan": 31536000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "organizationsEnabled": true,

  "clientScopes": [
    {
      "name": "prompt:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:read:restricted",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:create",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:publish",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:publish:public",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:rate",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:image",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "prompt:moderate",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "apikey:create",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "admin:manage_taxonomy",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "admin:manage_users",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "admin:read_audit",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],

  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access: prompt:read",
        "composite": false
      },
      {
        "name": "contributor",
        "description": "viewer + prompt:create prompt:write prompt:rate prompt:image",
        "composite": true,
        "composites": { "realm": ["viewer"] }
      },
      {
        "name": "publisher",
        "description": "contributor + prompt:publish",
        "composite": true,
        "composites": { "realm": ["contributor"] }
      },
      {
        "name": "admin",
        "description": "publisher + prompt:read:restricted prompt:publish:public prompt:moderate admin:*",
        "composite": true,
        "composites": { "realm": ["publisher"] }
      }
    ]
  },

  "groups": [
    {
      "name": "gallery-ops",
      "path": "/gallery-ops"
    }
  ],

  "clients": [
    {
      "clientId": "gallery-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },

    {
      "clientId": "gallery-app",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8000"],
      "defaultClientScopes": ["openid", "profile", "email"],
      "optionalClientScopes": [
        "prompt:read",
        "prompt:read:restricted",
        "prompt:create",
        "prompt:write",
        "prompt:publish",
        "prompt:publish:public",
        "prompt:rate",
        "prompt:image",
        "prompt:moderate",
        "apikey:create",
        "admin:manage_taxonomy",
        "admin:manage_users",
        "admin:read_audit"
      ],
      "protocolMappers": [
        {
          "name": "gallery-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "prompt-gallery-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },

    {
      "clientId": "org-deploy-example",
      "enabled": true,
      "publicClient": false,
      "secret": "org-deploy-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:9999/*"],
      "webOrigins": [],
      "defaultClientScopes": ["openid", "profile", "email"],
      "optionalClientScopes": [
        "prompt:read",
        "prompt:create",
        "prompt:write",
        "prompt:publish",
        "prompt:rate",
        "prompt:image",
        "apikey:create"
      ],
      "protocolMappers": [
        {
          "name": "gallery-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "prompt-gallery-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },

    {
      "clientId": "gallery-apikey-issuer",
      "enabled": true,
      "publicClient": false,
      "secret": "apikey-issuer-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["openid", "profile", "email"],
      "optionalClientScopes": [
        "prompt:read",
        "prompt:read:restricted",
        "prompt:create",
        "prompt:write",
        "prompt:publish",
        "prompt:publish:public",
        "prompt:rate",
        "prompt:image",
        "prompt:moderate",
        "apikey:create",
        "admin:manage_taxonomy",
        "admin:manage_users",
        "admin:read_audit"
      ],
      "protocolMappers": [
        {
          "name": "gallery-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "prompt-gallery-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
